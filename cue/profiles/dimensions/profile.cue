package dimensions

// Профиль «измерения» — группировка решений по осям, читаемым как
// `группа.ось = значение` (например system.layer = infrastructure).
//
// БАЗА открыта: любая группа, любая ось, значение — свободная строка (вариант C).
// ПРОЕКТ сужает нужные оси до набора допустимых значений через unification
// (вариант A): `system: layer: "domain" | "application" | "infrastructure"`.
// CUE даёт и то, и другое одним полем: кто не сужал — свободно, кто сузил —
// валидируется. Решение подставляет только значение: dimensions: {system: layer: "infrastructure"}.
//
// Эффективность точечных запросов по горячей оси — позже через индекс по
// выражению: CREATE INDEX ON decisions(json_extract(meta,'$.dimensions.<путь>')).
#Dimensions: {
	[string]: {[string]: string} // группа → ось → значение (по умолчанию свободно)
	...
}

// Подмешивается в #Decision: добавляет context.dimensions. Полностью открыт
// (... на каждом уровне) — иначе закрывает ядро-поля и не композируется
// с другими профилями.
#WithDimensions: {
	context: {
		dimensions: #Dimensions
		...
	}
	...
}
